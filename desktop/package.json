{
  "name": "kyrozen-desktop",
  "version": "0.1.0",
  "type": "module",
  "description": "Kyrozen desktop client for local agent execution",
  "author": "Kyrozen",
  "main": "dist-electron/main/main.js",
  "homepage": ".",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "fix-electron": "node scripts/postinstall.js",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "release": "npm run build",
    "build:renderer": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test:unit": "tsx --test electron/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.kyrozen.desktop",
    "productName": "Kyrozen",
    "afterSign": "scripts/notarize.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "python_agent",
        "to": "python_agent",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../kyrozen",
        "to": "kyrozen",
        "filter": [
          "**/*.py",
          "web/index.html"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "dist-electron/native-messaging-host",
        "to": "native-messaging-host"
      }
    ],
    "mac": {
      "identity": "-",
      "executableName": "Kyrozen",
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": "AppImage"
    },
    "protocols": [
      {
        "name": "Kyrozen Protocol",
        "schemes": [
          "kyrozen"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "EvanProgramming",
      "repo": "Kyrozen",
      "releaseType": "release"
    }
  }
}
